{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sismi",
  "version": "0.1.0",
  "identifier": "com.sismi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sismi · Monitoreo sísmico",
        "width": 390,
        "height": 720,
        "minWidth": 350,
        "minHeight": 600,
        "maxWidth": 390,
        "maxHeight": 720,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
