{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sismi",
  "version": "0.1.19",
  "identifier": "com.sismi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sismi · Monitoreo sísmico",
        "width": 390,
        "height": 720,
        "minWidth": 350,
        "minHeight": 600,
        "maxWidth": 390,
        "maxHeight": 720,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBM0JCQjc0NzZDQ0I1NEYKUldSUHRjeDJkTHM3V3ExbGhYdjJrT2lTZFFLUmxNaG92NmtxWmdGeXdSY3RJbHNRN0c2RzlSOXYK",
      "endpoints": [
        "https://github.com/Alejooc/sismi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
